# --- Google Places API (business search + autocomplete) ---
# Places API (New) key. Enable "Places API (New)" in Google Cloud Console.
# NOTE: rotate this key if it was ever committed/shared — the previous n8n
# workflow export had one hardcoded in plain text.
GOOGLE_PLACES_API_KEY=

# --- Anthropic (GMB audit AI report) ---
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# --- Outbound email (report-ready summary + PDF delivery) ---
# Option A (Recommended): Resend — resend.com, free tier covers this app easily.
# No 2FA/app-password setup; just an API key. Until you verify your own domain
# in Resend, RESEND_FROM_EMAIL must stay unset/onboarding@resend.dev and mail
# can only be delivered to the email you signed up to Resend with.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Option B: Gmail with an App Password (used only if RESEND_API_KEY is unset)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option C: any SMTP provider (used only if both of the above are unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Auth + reports storage (Supabase) ---
# Google sign-in is configured inside the Supabase dashboard (Auth → Providers → Google),
# not here — these two are the only values the app itself needs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only, bypasses Row Level Security. Never expose to the browser
# or commit it. Supabase dashboard → Project Settings → API → service_role key.
# Powers the admin panel (app/admin) and the /api/admin/* routes: user list,
# premium grants, leads, search logs, and coupons.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of Google account emails allowed into /admin.
ADMIN_EMAILS=

# --- Razorpay (payment to unlock full report) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRICE_AMOUNT=499
